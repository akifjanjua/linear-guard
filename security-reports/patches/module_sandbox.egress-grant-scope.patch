+def _addr_belongs_to(ip: str, hostname: str) -> bool:
+    """True if `ip` is one of the addresses `hostname` currently resolves to.
+
+    Defence in depth behind the connect-scoped grant: the grant names a HOST,
+    but the socket dials an ADDRESS, and nothing otherwise ties the two
+    together.
+
+    Fails OPEN when resolution itself fails (no DNS on this box, transient
+    SERVFAIL) — the scoping is the primary control and hard-failing here would
+    break offline runs the gate is not meant to police. Fails CLOSED when
+    resolution succeeds and the address is simply not in the answer set, which
+    is the case that matters.
+    """
+    import socket as _s
+    try:
+        infos = _s.getaddrinfo(hostname, None)
+    except Exception:
+        return True  # cannot resolve -> do not manufacture a denial
+    if not infos:
+        return True
+    return ip in {i[4][0] for i in infos}
+
