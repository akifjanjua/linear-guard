+        # LF-only, shipped as payload["handler_py"], and written verbatim by
+        # the installer — which since v0.77 correctly uses newline="" — so the
+        # buyer's tree hash mismatched and the module was rejected as
+        # "files edited after sign". The tarball and tree_manifest were fine;
+        # only this redundant payload string was corrupt, which is why publish's
+        # own signature self-check still passed.
+        with open(manifest_path, "r", encoding="utf-8", newline="") as f:
             manifest_text = f.read()
             manifest = json.loads(manifest_text)
-        with open(handler_path, "r", encoding="utf-8") as f:
